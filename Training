from fastai.vision.all import *
import tensorflow as tf
import torch
import onnx
from google.colab import files, drive
import zipfile, os
import shutil

drive.mount('/content/drive')
with zipfile.ZipFile('/content/drive/MyDrive/dataset.zip', 'r') as zip_ref:
    zip_ref.extractall('/content/data')

path = Path('/content/data/dataset')

dls = ImageDataLoaders.from_folder(
    path,
    valid_pct=0.2,
    seed=42,
    item_tfms=Resize(224),
    batch_tfms=aug_transforms(),
    bs=8
)

dls.show_batch()

learn = vision_learner(dls, resnet18, metrics=accuracy)

learn.fine_tune(10, base_lr=1e-3)

learn.show_results()
interp = ClassificationInterpretation.from_learner(learn)
interp.plot_confusion_matrix()
interp.plot_top_losses(2)

learn.export('/content/model.pkl')

learn = load_learner('/content/model.pkl')
model = learn.model.eval()

dummy_input = torch.randn(1, 3, 224, 224)

torch.onnx.export(
    model,
    dummy_input,
    "model.onnx",
    input_names=['input'],
    output_names=['output'],
    opset_version=13,
    dynamo=False
)

if not os.path.exists("/content/saved_model_dir"):
  os.mkdir("/content/saved_model_dir")

print(learn.dls.vocab)

!rm -rf tfjs_web_model
onnx_model = onnx.load("model.onnx")
!onnx2tf -i model.onnx -o saved_model_dir

files.download("/content/saved_model_dir/model_float32.tflite")
interpreter = tf.lite.Interpreter(model_path="/content/saved_model_dir/model_float32.tflite")
