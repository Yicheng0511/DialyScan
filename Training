from fastai.vision.all import *
import tensorflow as tf
import torch
import onnx
from google.colab import files, drive
import zipfile, os
import shutil

drive.mount('/content/drive')

!rm -rf /content/data

with zipfile.ZipFile('/content/drive/MyDrive/IR_Photos.zip', 'r') as zip_ref:
    zip_ref.extractall('/content/data')

path = Path('/content/data/IR_Photos')

dls = ImageDataLoaders.from_folder(
    path,
    valid_pct=0.2,
    seed=42,
    item_tfms=Resize(224, method="pad"),
    batch_tfms=aug_transforms(
        do_flip=True,
        flip_vert=True,
        max_rotate=10,
        max_zoom=1.1,
        max_lighting=0.2,
        max_warp=0.05
    ),
    bs=8
)

dls.show_batch()

learn = vision_learner(dls, efficientnet_b0, metrics=[
    accuracy,
    Precision(average='macro'),
    Recall(average='macro'),
    F1Score(average='macro')
  ])

learn.fine_tune(30, base_lr=1e-3)

learn.show_results()
interp = ClassificationInterpretation.from_learner(learn)
interp.plot_confusion_matrix()
interp.plot_top_losses(2)

learn.export('/content/model.pkl')



from google.colab import files, drive
learn = load_learner('/content/model.pkl')
model = learn.model.eval()

dummy_input = torch.randn(1, 3, 224, 224)

with torch.no_grad():
  torch.onnx.export(
      model,
      dummy_input,
      "model.onnx",
      input_names=['input'],
      output_names=['output'],
      opset_version=13,
      dynamo=False
  )

!rm -rf /content/saved_model_dir
if not os.path.exists("/content/saved_model_dir"):
  os.mkdir("/content/saved_model_dir")

!rm -rf tfjs_web_model
onnx_model = onnx.load("model.onnx")
!onnx2tf -i /content/model.onnx -o /content/saved_model_dir -tb tf_converter
!find saved_model_dir -name "saved_model.pb"
!tensorflowjs_converter \
  --input_format=tf_saved_model \
  --output_format=tfjs_graph_model \
  /content/saved_model_dir \
  /content/tfjs_web_model
!ls -l /content/tfjs_web_model

shutil.make_archive('/content/tfjs_model', 'zip', '/content/tfjs_web_model')
files.download('tfjs_model.zip')

test_files = get_image_files(path / "Test")

test_dl = dls.test_dl(test_files)

preds, _ = learn.get_preds(dl=test_dl)

pred_classes = preds.argmax(dim=1)

print(pred_classes)

test_targets = torch.tensor([
    learn.dls.vocab.o2i[parent_label(f)]
    for f in test_files
])

from sklearn.metrics import confusion_matrix, classification_report

print(confusion_matrix(test_targets, pred_classes))

print(classification_report(
    test_targets,
    pred_classes,
    target_names=learn.dls.vocab,
    zero_division=0
))
