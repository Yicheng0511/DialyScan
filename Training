from fastai.vision.all import *
import torch
import onnx
import zipfile
import os
TF_ENABLE_ONEDNN_OPTS = 0
destination_dir = r"C:/Users/Yiche/OneDrive/Documents/data"

if not os.path.exists(destination_dir):
    os.makedirs(destination_dir)

with zipfile.ZipFile(r"C:/Users/Yiche/OneDrive/Documents/dataset.zip", 'r') as zip_ref:
    zip_ref.extractall(destination_dir)

path = Path(destination_dir + '/dataset')
if __name__ == '__main__':
    dls = ImageDataLoaders.from_folder(
        path,
        valid_pct=0.2,
        seed=42,
        item_tfms=Resize(224),
        batch_tfms=aug_transforms(),
        bs=8
    )

    dls.show_batch()

    learn = vision_learner(dls, resnet18, metrics=accuracy)

    learn.fine_tune(10, base_lr=1e-3)

    learn.show_results()
    interp = ClassificationInterpretation.from_learner(learn)
    interp.plot_confusion_matrix()
    interp.plot_top_losses(2)

    learn.export('r"C:/Users/Yiche/OneDrive/Documents/data"/model.pkl')

    learn = load_learner('r"C:/Users/Yiche/OneDrive/Documents/data"/model.pkl')
    model = learn.model.eval()

    dummy_input = torch.randn(1, 3, 224, 224)

    traced_model = torch.jit.trace(model, dummy_input)
    traced_model.save("model.pt")

    torch.onnx.export(
        model,
        tuple(dummy_input),
        "model.onnx",
        input_names=['input'],
        output_names=['output'],
        opset_version=13,
        dynamo=False
    )

    onnx_model = onnx.load("model.onnx")
